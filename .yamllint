---
extends: default

ignore: |
  .ansible/
  .terraform/
  .venv/
  venv/
  collections/ansible_collections/

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  # The settings below keep yamllint compatible with ansible-lint's yaml rule.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  indentation:
    spaces: 2
    indent-sequences: consistent
